# IOCL Digital Pump Manager - Environment Configuration Example

# Cloudflare D1 Database Binding (accessed in Cloudflare Workers via env.DB)
# For local development with Node/Express, local SQLite is configured via src/db/localD1.ts.
# For remote migrations, use: npm run db:migrate:remote

# Cloudflare R2 Bucket Binding (accessed in Cloudflare Workers via env.DOCUMENTS_BUCKET)
# Used for secure object storage of outlet documents, licenses, and inspection certificates.

# Approved Frontend Origins (exact matching, comma-separated)
# In production, specify only the exact authorized domain(s).
# Local development automatically allows localhost:3000 and 127.0.0.1:3000.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application Environment ('development' | 'production')
ENVIRONMENT="development"
